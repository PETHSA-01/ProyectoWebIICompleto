# ------------------------------------------------------------------
# SOLO SERVIDOR (sin PUBLIC_): no se inyectan en el bundle del navegador.
# ------------------------------------------------------------------

# URL del backend GraphQL. Solo la usa el servidor de Astro: las paginas
# .astro consultan directo, y las islas de React van por el proxy
# /api/graphql que reenvia aqui. Por eso pierde el prefijo PUBLIC_ que
# tenia antes: la URL del backend ya no se le entrega a nadie del cliente.
GRAPHQL_URL=http://localhost:4001/graphql

# Secreto para firmar la cookie de sesion (HMAC-SHA256). La cookie lleva
# dentro el JWT del backend, asi que este valor es lo que impide que alguien
# se invente una sesion ajena. Sin esto, el login falla.
# Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=pega-aqui-el-secreto-generado

# La cookie de sesion se marca Secure solo en builds de produccion (que es lo
# correcto: debe viajar por HTTPS). En desarrollo Astro ya la deja sin Secure
# automaticamente, asi que no hay que tocar esto. Solo ponlo en false si
# pruebas un build de produccion sirviendo por http://localhost, donde un
# cliente HTTP estricto no reenvia cookies Secure.
# SESSION_COOKIE_SECURE=false

# ------------------------------------------------------------------
# PUBLICA: si se inyecta en el bundle del navegador.
# ------------------------------------------------------------------

# Client ID de Google (el mismo que GOOGLE_CLIENT_ID en el backend). Sigue
# siendo publico porque el boton oficial de Google se inicializa en el
# navegador; eso no es un secreto. No se necesita client secret: el flujo
# usa Google Identity Services, sin codigo de autorizacion ni redirect URI.
PUBLIC_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# Public Key de Mercado Pago (misma que MP_PUBLIC_KEY en backend/.env). La
# usa MercadoPago.js v2 en el navegador para tokenizar la tarjeta del
# Checkout API; por eso SI debe exponerse con el prefijo PUBLIC_. Nunca
# poner aqui el Access Token (MP_ACCESS_TOKEN): ese solo va en el backend.
PUBLIC_MP_PUBLIC_KEY=APP_USR-tu-public-key

# URL del WebSocket del backend para las suscripciones GraphQL (stock en vivo).
# Va DIRECTO al backend (no por el proxy de Netlify, que no pasa WebSockets):
#   local:       ws://localhost:4001/graphql
#   produccion:  wss://TU-BACKEND.onrender.com/graphql
# Si se deja vacia, la tienda funciona igual pero sin actualizacion en vivo.
PUBLIC_GRAPHQL_WS_URL=ws://localhost:4001/graphql

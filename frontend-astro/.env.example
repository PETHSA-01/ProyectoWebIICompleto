# URL del backend GraphQL. Se usa tanto en el servidor (paginas .astro,
# que corren en Node) como en el navegador (islas de React), por eso lleva
# el prefijo PUBLIC_ que Astro expone al cliente.
PUBLIC_GRAPHQL_URL=http://localhost:4001/

# Client ID de Google (el mismo que GOOGLE_CLIENT_ID en el backend).
# Se usa en la isla de login para inicializar el boton de Google.
PUBLIC_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# Generado para la rama AstroMongoYOAuth2.
#
#  ATENCION: este archivo NO esta en .gitignore (el .gitignore raiz esta
#  vacio, y sin el prefijo PUBLIC_ nada mas lo protege). No lo agregues
#  a ningun commit. Usa git add con rutas explicicas.

# Firma la cookie de sesion (HMAC-SHA256). 48 bytes aleatorios.
# Si lo pierdes, todas las sesiones abiertas quedan invalidas (no rompe nada mas).
SESSION_SECRET=97e735adc3050e69fe1d4813dae3711168113956c6f035a49bffefd7fd690ad16b55b999eba59c3c58015a59be6145a6

# URL del backend GraphQL. Solo la usa el servidor de Astro; las islas van
# por el proxy /api/graphql, asi que nunca se expone al navegador.
GRAPHQL_URL=http://localhost:4001/

# Client ID de Google. Debe ser el MISMO que GOOGLE_CLIENT_ID en backend/.env.
# CAMBIAR antes de probar el login: Google Cloud Console > APIs y servicios >
# Credenciales > ID de cliente OAuth 2.0 > ID de cliente.
PUBLIC_GOOGLE_CLIENT_ID=983738489619-47afiu5jemougd5jma1qtqo8b9gtsr3o.apps.googleusercontent.com

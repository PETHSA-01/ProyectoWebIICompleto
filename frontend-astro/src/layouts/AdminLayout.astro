---
import '../styles/tokens.css';
import '../styles/admin.css';
import ThemeToggle from '../components/ThemeToggle.jsx';
import { nombreRolEs } from '../lib/formatos.js';
import {
  IconoOrdenes,
  IconoPanel,
  IconoProducto,
  IconoTienda,
  IconoInventario,
  IconoCompras,
  IconoVentas,
  IconoFactura,
  IconoEnvio,
  IconoClientes,
  IconoProveedores,
  IconoReportes,
} from '../components/Iconos.jsx';
import BadgeStockBajo from '../components/BadgeStockBajo.jsx';

// Panel de administración (/admin/*). Ya lo protege el middleware: aquí ya
// sabemos que Astro.locals.sesion.usuario existe y es ADMIN u OPERADOR.
const { title = 'Panel' } = Astro.props;
const usuario = Astro.locals.sesion.usuario;
const ruta = Astro.url.pathname;

// Finanzas (ventas, facturación, reportes) es solo ADMIN. Proveedores se
// consulta con ambos roles, pero solo ADMIN edita (lo valida el backend).
const esAdmin = usuario.rol === 'ADMIN';
const articulos = [
  { href: '/admin', etiqueta: 'Dashboard', Icono: IconoPanel },
  { href: '/admin/productos', etiqueta: 'Productos', Icono: IconoProducto },
  { href: '/admin/inventario', etiqueta: 'Inventario', Icono: IconoInventario, badge: true },
  { href: '/admin/compras', etiqueta: 'Compras', Icono: IconoCompras },
  { href: '/admin/ordenes', etiqueta: 'Órdenes', Icono: IconoOrdenes },
  { href: '/admin/envios', etiqueta: 'Envíos', Icono: IconoEnvio },
  ...(esAdmin
    ? [
        { href: '/admin/ventas', etiqueta: 'Ventas', Icono: IconoVentas },
        { href: '/admin/facturacion', etiqueta: 'Facturación', Icono: IconoFactura },
      ]
    : []),
  { href: '/admin/clientes', etiqueta: 'Clientes', Icono: IconoClientes },
  { href: '/admin/proveedores', etiqueta: 'Proveedores', Icono: IconoProveedores },
  ...(esAdmin ? [{ href: '/admin/reportes', etiqueta: 'Reportes', Icono: IconoReportes }] : []),
];

const iniciales = (usuario.nombre || usuario.email || '?')
  .trim()
  .split(/\s+/)
  .slice(0, 2)
  .map((p) => p.charAt(0).toUpperCase())
  .join('');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · NexoPlay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
    <script is:inline>
      (function () {
        try {
          var guardado = localStorage.getItem('nexoplay_tema');
          var oscuro =
            guardado === 'dark' ||
            (guardado !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.setAttribute('data-theme', oscuro ? 'dark' : 'light');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="admin">
      <aside class="admin__sidebar">
        <a class="admin__marca" href="/admin" title="Panel de administración">
          <img
            src="/Gemini_Generated_Image_ioo3eiioo3eiioo3.png"
            alt=""
            width="32"
            height="32"
            class="admin__marca-img"
          />
          <span class="admin__marca-nombre">
            <span>Nexo<span style="color: var(--accent);">Play</span></span>
            <small>Panel</small>
          </span>
        </a>

        <nav class="admin__nav">
          {articulos.map((a) => (
            <a
              href={a.href}
              class:list={{ 'admin__enlace': true, 'admin__enlace--activo': ruta === a.href }}
              title={a.etiqueta}
            >
              <a.Icono size={20} />
              <span class="admin__enlace-lb">{a.etiqueta}</span>
              {a.badge && <BadgeStockBajo client:load />}
            </a>
          ))}
        </nav>

        <div class="admin__usuario">
          <div class="admin__usuario-fila">
            <span class="admin__avatar" aria-hidden="true">{iniciales}</span>
            <div class="admin__datos">
              <strong>{usuario.nombre || usuario.email}</strong>
              <small>{nombreRolEs(usuario.rol)}</small>
            </div>
          </div>
          <div class="admin__usuario-acciones">
            <a href="/" class="accion-icono" title="Regresar a la página principal" aria-label="Regresar a la página principal">
              <IconoTienda size={20} />
              <span class="tooltip">Regresar a la página principal</span>
            </a>
          </div>
        </div>
      </aside>

      <main class="admin__contenido">
        <header class="admin__cabecera">
          <nav class="admin__migas" aria-label="Ruta del panel">
            NexoPlay / <span>{title}</span>
          </nav>
          <div class="admin__cabecera-der">
            <ThemeToggle client:load compacto />
            <span class="admin__cabecera-avatar" aria-hidden="true">{iniciales}</span>
          </div>
        </header>

        <div class="admin__contenido-inner">
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
---
import BaseLayout from '../layouts/BaseLayout.astro';
import { graphqlRequest, QUERIES } from '../lib/graphql.js';

// Esta pagina se renderiza en el servidor (Node) en cada peticion (output:
// "server" en astro.config.mjs): el fetch al backend GraphQL corre aqui,
// ANTES de mandar el HTML al navegador. El navegador recibe la pagina ya
// con el catalogo, sin tener que pedirlo por su cuenta.
let categorias = [];
let productosDestacados = [];
let errorCarga = null;

try {
  const [dataCategorias, dataProductos] = await Promise.all([
    graphqlRequest(QUERIES.categorias),
    graphqlRequest(QUERIES.productosDestacados, { limite: 8 }),
  ]);
  categorias = dataCategorias.categorias;
  productosDestacados = dataProductos.productos;
} catch (err) {
  errorCarga = err.message;
}
---
<BaseLayout title="Inicio">
  <section class="hero">
    <div class="contenedor">
      <h1>Todo para tu setup Xbox, en un solo lugar</h1>
      <p>Consolas, controles, audifonos y videojuegos con envio a todo México.</p>
    </div>
  </section>

  {errorCarga && (
    <div class="contenedor">
      <p class="error">No se pudo cargar el catalogo: {errorCarga}</p>
    </div>
  )}

  <section class="contenedor">
    <h2>Categorías</h2>
    <div class="grid-categorias">
      {categorias.map((cat) => (
        <a href={`/categoria/${cat.id}`} class="tarjeta-categoria">
          <span>{cat.nombre}</span>
          <small>{cat.productos.length} productos</small>
        </a>
      ))}
    </div>
  </section>

  <section class="contenedor">
    <h2>Destacados</h2>
    <div class="grid-productos">
      {productosDestacados.map((p) => (
        <a href={`/producto/${p.id}`} class="tarjeta-producto">
          <img src={p.imagen} alt={p.nombre} loading="lazy" />
          <div class="tarjeta-producto__info">
            <span class="tarjeta-producto__nombre">{p.nombre}</span>
            <span class="tarjeta-producto__categoria">{p.categoria.nombre}</span>
            <strong>${Number(p.precio).toFixed(2)} MXN</strong>
          </div>
        </a>
      ))}
    </div>
  </section>

  <style>
    .hero {
      background: linear-gradient(135deg, var(--violeta), var(--violeta-oscuro));
      color: white;
      padding: 56px 0;
      margin-bottom: 32px;
    }
    .hero h1 { font-family: var(--font-display); font-size: 32px; margin: 0 0 8px; }
    .hero p { margin: 0; opacity: 0.9; }
    h2 { font-family: var(--font-display); margin-top: 40px; }
    .grid-categorias {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 16px;
    }
    .tarjeta-categoria {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 20px;
      text-decoration: none;
      color: var(--texto);
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .tarjeta-categoria span { font-weight: 700; font-size: 18px; }
    .tarjeta-categoria small { color: var(--texto-secundario); }
    .grid-productos {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 20px;
    }
    .tarjeta-producto {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      text-decoration: none;
      color: var(--texto);
    }
    .tarjeta-producto img { width: 100%; height: 160px; object-fit: cover; background: var(--surface-muted); }
    .tarjeta-producto__info { padding: 14px; display: flex; flex-direction: column; gap: 4px; }
    .tarjeta-producto__nombre { font-weight: 600; }
    .tarjeta-producto__categoria { font-size: 12px; color: var(--texto-secundario); }
    .error { color: var(--error); }
  </style>
</BaseLayout>

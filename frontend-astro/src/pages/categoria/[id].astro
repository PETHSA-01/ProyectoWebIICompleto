---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { graphqlRequest, QUERIES } from '../../lib/graphql.js';

const { id } = Astro.params;

let categoria = null;
let errorCarga = null;
try {
  const data = await graphqlRequest(QUERIES.categoria, { id });
  categoria = data.categoria;
} catch (err) {
  errorCarga = err.message;
}

if (!categoria && !errorCarga) {
  return Astro.redirect('/404');
}
---
<BaseLayout title={categoria ? categoria.nombre : 'Categoría'}>
  <section class="contenedor">
    <a href="/" class="volver">← Volver al inicio</a>

    {errorCarga && <p class="error">No se pudo cargar la categoría: {errorCarga}</p>}

    {categoria && (
      <>
        <h1>{categoria.nombre}</h1>
        <div class="grid-productos">
          {categoria.productos.map((p) => (
            <a href={`/producto/${p.id}`} class="tarjeta-producto">
              <img src={p.imagen} alt={p.nombre} loading="lazy" />
              <div class="tarjeta-producto__info">
                <span class="tarjeta-producto__nombre">{p.nombre}</span>
                <strong>${Number(p.precio).toFixed(2)} MXN</strong>
                <small>{p.stock > 0 ? `${p.stock} en stock` : 'Sin stock'}</small>
              </div>
            </a>
          ))}
        </div>
      </>
    )}
  </section>

  <style>
    .volver { color: var(--texto-secundario); text-decoration: none; font-size: 14px; }
    h1 { font-family: var(--font-display); margin-top: 12px; }
    .grid-productos {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 20px;
      margin-top: 24px;
    }
    .tarjeta-producto {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      text-decoration: none;
      color: var(--texto);
    }
    .tarjeta-producto img { width: 100%; height: 160px; object-fit: cover; background: var(--surface-muted); }
    .tarjeta-producto__info { padding: 14px; display: flex; flex-direction: column; gap: 4px; }
    .tarjeta-producto__nombre { font-weight: 600; }
    .tarjeta-producto__info small { color: var(--texto-secundario); }
    .error { color: var(--error); }
  </style>
</BaseLayout>

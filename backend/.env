# --- Postgres local (ver pasos de instalacion que dio el asistente) ---
# sslmode=disable: conexion local por TCP, sin TLS.
DATABASE_URL=postgres://nexoplay_app:nexoplay_dev@localhost:5432/nexoplay?sslmode=disable

# --- JWT ---
# Este backend firma/verifica sus tokens con este secreto. En el stack del
# repo coincidia con "jwt-secret" de postgrest.conf; como PostgREST no corre,
# mantenerlo igual solo importa si lo montas algun dia.
JWT_SECRET=2357f4acf5cab19caa81ad16516b79f2200f3e3f12b979ccb36807d836d84c053f3053029b61b2343a30549da5a95b5e
JWT_EXPIRES_IN=7d

# --- OAuth2 con Google (el mismo publico del frontend-astro) ---
GOOGLE_CLIENT_ID=983738489619-47afiu5jemougd5jma1qtqo8b9gtsr3o.apps.googleusercontent.com

# --- Servidor ---
PORT=4001

# --- Postgres ---
# Usuario/rol de aplicacion (NO el usuario "authenticator" que usa PostgREST).
DATABASE_URL=postgres://nexoplay_app:nexoplay_dev@localhost:5432/nexoplay

# --- JWT propio (firma los tokens que emite este backend) ---
# Debe ser EXACTAMENTE el mismo valor que "jwt-secret" en postgrest.conf,
# porque el mismo token se usa para autorizar tanto GraphQL como PostgREST.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# --- OAuth2 con Google ---
# Se crea en https://console.cloud.google.com/apis/credentials
# Tipo de credencial: "ID de cliente de OAuth" > "Aplicacion web"
# Opcional: el login local (correo+contrasena) no la necesita.
GOOGLE_CLIENT_ID=

# --- Servidor ---
PORT=4001
# URL publica del frontend: se usa en las URLs de retorno de las pasarelas.
# Con http://localhost Mercado Pago no activa auto_return (exige HTTPS); el
# cliente vuelve igual desde la pasarela y el estado se consulta por API.
APP_URL=http://localhost:4321

# --- Mercado Pago (sandbox, Checkout API / Checkout Transparente) ---
# Credenciales en https://www.mercadopago.com.mx/developers/panel/app
# MP_ACCESS_TOKEN cobra server-side (POST /v1/payments). MP_PUBLIC_KEY la usa
# el navegador para tokenizar la tarjeta, por eso tambien debe copiarse como
# PUBLIC_MP_PUBLIC_KEY en frontend-astro/.env.
MP_ACCESS_TOKEN=APP_USR-...
MP_PUBLIC_KEY=APP_USR-...
# Se usa para validar la firma x-signature de los webhooks de produccion.
MP_WEBHOOK_SECRET=

# --- PayPal (sandbox, Orders API v2) ---
# App en https://www.paypal.com/developers/apps (sandbox). PAYPAL_MODE solo
# acepta "sandbox" o "live".
PAYPAL_CLIENT_ID=tu-client-id
PAYPAL_SECRET=tu-secret
PAYPAL_MODE=sandbox

# Solo sandbox: correo de un COMPRADOR de prueba de Mercado Pago (Cuentas de
# prueba). Si se define, los cobros con tarjeta usan este correo en lugar del
# de la sesion, porque con credenciales de prueba MP rechaza compradores reales
# ("Unauthorized use of live credentials"). Dejar vacio en produccion.
# MP_TEST_PAYER_EMAIL=test_user_XXXXXXXXXX@testuser.com

# --- Facturación CFDI 4.0 (datos del emisor) ---
# El XML se genera completo, pero NO se timbra: el UUID fiscal queda vacío
# hasta conectar un PAC real. Estos datos son los del emisor en el CFDI.
CFDI_RFC_EMISOR=XAXX010101000
CFDI_NOMBRE_EMISOR=NexoPlay Demo SA de CV
CFDI_REGIMEN_EMISOR=601
CFDI_CP_EMISOR=45670

# --- Paqueterías (opcional) ---
# Sin estas claves el adaptador emite una guía SIMULADA con formato real,
# marcada como simulada en la base y en la interfaz. Nunca se finge una guía.
DHL_API_KEY=
ESTAFETA_API_KEY=
FEDEX_API_KEY=
